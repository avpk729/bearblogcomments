# --- Database ---
# On Railway, add a Postgres plugin and this is injected automatically.
# For local dev, point it at your own Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/guestbook

# Set to "require" if your Postgres requires SSL (some managed providers do).
# Railway's internal connection does NOT need this. Leave blank otherwise.
PGSSL=

# --- Cloudflare Turnstile (human challenge) ---
# Get these free at https://dash.cloudflare.com/?to=/:account/turnstile
# Add your blog domain (curiously.bearblog.dev) AND your Railway domain to the
# Turnstile widget's allowed hostnames.
# If left blank, the captcha is skipped (useful for local dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Moderation ---
# A long random secret. You'll paste this into the /admin page to moderate.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Limits ---
MAX_NAME_LENGTH=50
MAX_BODY_LENGTH=280

# --- CORS ---
# Comma-separated list of sites allowed to embed the guestbook.
# Use "*" to allow any origin, or lock it down to your blog.
ALLOWED_ORIGINS=https://curiously.bearblog.dev

# Port (Railway sets this automatically).
PORT=3000
