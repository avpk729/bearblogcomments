# ── Database ──────────────────────────────────────────────────────────────
# On Railway, add a Postgres plugin and DATABASE_URL is injected automatically.
# Locally, point it at your own Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/bearblog_comments

# Set to "require" if your Postgres requires SSL (some managed providers do).
# Railway's internal connection does NOT need this. Leave blank otherwise.
PGSSL=

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL of THIS service (used in magic-link emails + Stripe redirects).
APP_BASE_URL=http://localhost:3000
PORT=3000

# Secret used to sign/derive session + magic-link tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Salt for hashing commenter IPs (never stored raw). Generate like SESSION_SECRET.
IP_HASH_SALT=change-me-to-another-long-random-string

# ── Email (magic-link login) ────────────────────────────────────────────────
# SMTP credentials for sending login links. Leave blank in dev to print links
# to the server console instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bear Blog Comments <noreply@example.com>

# ── Cloudflare Turnstile (human challenge) ──────────────────────────────────
# Free at https://dash.cloudflare.com/?to=/:account/turnstile
# One widget serves all customer domains: DISABLE hostname validation in the
# Cloudflare dashboard; the server validates the returned hostname against each
# site's registered domains instead. Blank = captcha skipped (dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Stripe (billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe dashboard (recurring for monthly/yearly, one-time
# for lifetime).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

# ── One-time backfill (optional) ────────────────────────────────────────────
# Set these ONCE, before the first production migration, to import the legacy
# single-tenant `notes` guestbook into a site you own. Safe to leave blank.
OPERATOR_EMAIL=
OPERATOR_SITE_NAME=My Blog
